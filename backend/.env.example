# Copy to backend/.env and adjust. Every variable is optional for local use.

# Token signing key (32+ characters). If empty, a random key is generated once
# in data/.secret_key. Set it explicitly when running several server instances:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
VS_SECRET_KEY=

# SQLite by default. PostgreSQL example:
# VS_DATABASE_URL=postgresql+psycopg://voicestudio:password@localhost:5432/voicestudio

# Whisper model: tiny | base | small | medium | large-v3   (device: auto | cpu | cuda)
VS_WHISPER_MODEL=small
VS_WHISPER_DEVICE=auto
VS_WHISPER_COMPUTE_TYPE=int8

# Speaker diarization (pyannote.audio). Create a token at https://huggingface.co/settings/tokens
# and accept the conditions of pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
VS_HF_TOKEN=

# Text to speech: piper (local, free) | azure (cloud, paid)
VS_TTS_PROVIDER=piper
# VS_AZURE_SPEECH_KEY=
# VS_AZURE_SPEECH_REGION=westeurope

# OCR: rapidocr | paddleocr
VS_OCR_PROVIDER=rapidocr

# Set to true when the server is reachable from other machines.
VS_REQUIRE_AUTH_FOR_AI=false
